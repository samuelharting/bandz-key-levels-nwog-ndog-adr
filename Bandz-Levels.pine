// Original Bandz implementation of the author's D/W/M/Y references,
// percentage levels, alerts, and label behavior.
// This implementation does not import or reuse third-party Pine source.

bandz_levels_line_style(string selection) =>
    switch selection
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

bandz_levels_text_size(string selection) =>
    switch selection
        "Huge"   => size.huge
        "Large"  => size.large
        "Normal" => size.normal
        "Small"  => size.small
        "Auto"   => size.auto
        => size.tiny
