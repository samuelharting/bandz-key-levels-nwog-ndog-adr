// Custom chart-timeframe gates.
chart_tf_seconds = timeframe.in_seconds(timeframe.period)

tf_is_between(string min_tf, string max_tf) =>
    float min_seconds = timeframe.in_seconds(min_tf)
    float max_seconds = timeframe.in_seconds(max_tf)
    float lower_bound = math.min(min_seconds, max_seconds)
    float upper_bound = math.max(min_seconds, max_seconds)
    timeframe.isintraday and chart_tf_seconds >= lower_bound and chart_tf_seconds <= upper_bound

is_weekly_levels_tf  = tf_is_between(weekly_min_tf, weekly_max_tf)
is_monthly_levels_tf = tf_is_between(monthly_min_tf, monthly_max_tf)



// ---------------------------------------- Record-owned drawing state --------------------------------------------
type BandzLevelMark
    line levelLine
    label levelLabel
    float price
    string baseText
    int startBar

type BandzPeriodPair
    line highLine
    line lowLine
    label highLabel
    label lowLabel
    float highPrice
    float lowPrice
    int startBar
    bool highAlerted
    bool lowAlerted

type BandzPeriodBook
    BandzLevelMark[] opens
    BandzPeriodPair[] ranges

type BandzRatioBook
    BandzLevelMark[] levels


// BEST MIX: store a stable base_price so merges/restores don't drift
type label_info
    label lbl
    string base_text
    float base_price
    int created
    bool active

var label_info[] master_labels = array.new<label_info>()

var BandzPeriodBook dailyBook = BandzPeriodBook.new(array.new<BandzLevelMark>(), array.new<BandzPeriodPair>())
var BandzPeriodBook weeklyBook = BandzPeriodBook.new(array.new<BandzLevelMark>(), array.new<BandzPeriodPair>())
var BandzPeriodBook monthlyBook = BandzPeriodBook.new(array.new<BandzLevelMark>(), array.new<BandzPeriodPair>())
var BandzPeriodBook yearlyBook = BandzPeriodBook.new(array.new<BandzLevelMark>(), array.new<BandzPeriodPair>())

var BandzRatioBook dailyEqBook = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook weekly25Book = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook weeklyEqBook = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook weekly75Book = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook monthly25Book = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook monthlyEqBook = BandzRatioBook.new(array.new<BandzLevelMark>())
var BandzRatioBook monthly75Book = BandzRatioBook.new(array.new<BandzLevelMark>())


// Confirmed previous-period values. Using prior HTF bars keeps these levels
// identical when switching between chart timeframes.
current_d_open = request.security(syminfo.tickerid, "D", open, barmerge.gaps_off, barmerge.lookahead_on)
prev_d_high = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
prev_d_low = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on)
current_w_open = request.security(syminfo.tickerid, "W", open, barmerge.gaps_off, barmerge.lookahead_on)
prev_w_high = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_on)
prev_w_low = request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_off, barmerge.lookahead_on)
current_m_open = request.security(syminfo.tickerid, "M", open, barmerge.gaps_off, barmerge.lookahead_on)
prev_m_high = request.security(syminfo.tickerid, "M", high[1], barmerge.gaps_off, barmerge.lookahead_on)
prev_m_low = request.security(syminfo.tickerid, "M", low[1], barmerge.gaps_off, barmerge.lookahead_on)
current_y_open = request.security(syminfo.tickerid, "12M", open, barmerge.gaps_off, barmerge.lookahead_on)

var color bandz_levels_transparent = #ffffff00

bool bandz_day_changed = timeframe.change("D")
bool bandz_week_changed = timeframe.change("W")
bool bandz_month_changed = timeframe.change("M")
bool bandz_year_changed = timeframe.change("12M")
// ---------------------------------------- Variables & Constants --------------------------------------------------
prices_are_close(float p1, float p2) =>
    if na(p1) or na(p2)
        false
    else
        // Use absolute prices so the comparison also behaves correctly on
        // instruments whose values can approach or cross zero. The tiny
        // mintick epsilon prevents exact-threshold pairs from being split by
        // floating-point rounding.
        float ref = math.max(math.max(math.abs(p1), math.abs(p2)), syminfo.mintick)
        float threshold = ref * (combine_threshold / 100.0)
        float epsilon = syminfo.mintick * 0.001
        math.abs(p1 - p2) <= threshold + epsilon

register_label(float price, string base_txt, label lbl, bool merge_ok) =>
    if merge_ok and not na(lbl) and not na(price)
        // A drawing should only have one registry entry. Besides preventing
        // duplicate text, updating an existing entry makes this safe to call
        // again when a label is refreshed or reactivated.
        bool already_registered = false
        if array.size(master_labels) > 0
            for i = 0 to array.size(master_labels) - 1
                li = array.get(master_labels, i)
                if li.lbl == lbl
                    li.base_text  := base_txt
                    li.base_price := price
                    li.active     := true
                    array.set(master_labels, i, li)
                    already_registered := true
                    break

        if not already_registered
            array.push(master_labels, label_info.new(lbl, base_txt, price, time, true))

unregister_label(label lbl) =>
    if not na(lbl) and array.size(master_labels) > 0
        for i = 0 to array.size(master_labels) - 1
            li = array.get(master_labels, i)
            if li.active and li.lbl == lbl
                li.active := false
                array.set(master_labels, i, li)
                break

// Restore from base_price so merges never "drift"
restore_all_label_texts() =>
    if array.size(master_labels) > 0
        for i = 0 to array.size(master_labels) - 1
            li = array.get(master_labels, i)
            if li.active and not na(li.lbl)
                p = li.base_price
                if na(p)
                    p := label.get_y(li.lbl)
                if not na(p)
                    label.set_y(li.lbl, p)
                txt = label_price and not na(p) ? str.format("{0} ({1})", li.base_text, p) : li.base_text
                label.set_text(li.lbl, txt)

// Combine close labels, but keep the merged label:
// - on the RIGHTMOST label (so it stays in the right column)
// - at a REAL level price (primary label's base_price), not an average
combine_persistent_labels() =>
    if not combine_labels
        restore_all_label_texts()
        0
    else
        restore_all_label_texts()

        tmp_lbls    = array.new<label>()
        tmp_text    = array.new_string()
        tmp_created = array.new_int()
        tmp_price   = array.new_float()
        tmp_x       = array.new_int()

        // Pine's for-loop can count downward when its end is below its start,
        // so explicitly guard the empty array instead of iterating 0 to -1.
        if array.size(master_labels) > 0
            for ii = 0 to array.size(master_labels) - 1
                li = array.get(master_labels, ii)
                if li.active and not na(li.lbl) and not na(li.base_price)
                    x = label.get_x(li.lbl)
                    if not na(x)
                        array.push(tmp_lbls,    li.lbl)
                        array.push(tmp_text,    li.base_text)
                        array.push(tmp_created, li.created)
                        array.push(tmp_price,   li.base_price)
                        array.push(tmp_x,       x)

        m = array.size(tmp_lbls)
        if m > 1
            // insertion sort by price (keep arrays aligned)
            for ii = 1 to m - 1
                key_p = array.get(tmp_price,   ii)
                key_l = array.get(tmp_lbls,    ii)
                key_t = array.get(tmp_text,    ii)
                key_c = array.get(tmp_created, ii)
                key_x = array.get(tmp_x,       ii)

                jj = ii - 1
                while jj >= 0
                    if array.get(tmp_price, jj) > key_p
                        array.set(tmp_price,   jj + 1, array.get(tmp_price,   jj))
                        array.set(tmp_lbls,    jj + 1, array.get(tmp_lbls,    jj))
                        array.set(tmp_text,    jj + 1, array.get(tmp_text,    jj))
                        array.set(tmp_created, jj + 1, array.get(tmp_created, jj))
                        array.set(tmp_x,       jj + 1, array.get(tmp_x,       jj))
                        jj -= 1
                    else
                        break

                array.set(tmp_price,   jj + 1, key_p)
                array.set(tmp_lbls,    jj + 1, key_l)
                array.set(tmp_text,    jj + 1, key_t)
                array.set(tmp_created, jj + 1, key_c)
                array.set(tmp_x,       jj + 1, key_x)

            i = 0
            while i < m
                previous_price = array.get(tmp_price, i)
                count          = 1
                combined       = array.get(tmp_text,  i)

                primary_idx     = i
                primary_created = array.get(tmp_created, i)
                primary_x       = array.get(tmp_x, i)

                members = array.new_int()
                array.push(members, i)

                j = i + 1
                while j < m
                    pj = array.get(tmp_price, j)
                    // Prices are sorted, so checking each adjacent pair forms
                    // one stable cluster. The former moving-average check could
                    // incorrectly reject the last label in a close stack.
                    if not prices_are_close(previous_price, pj)
                        break

                    combined := combined + " / " + array.get(tmp_text, j)
                    count    += 1
                    previous_price := pj

                    xj = array.get(tmp_x, j)
                    cj = array.get(tmp_created, j)

                    // PRIMARY: rightmost label (keeps merged text in the right column)
                    // tie-break: older created
                    if (not na(xj) and (na(primary_x) or xj > primary_x)) or ((not na(xj) and not na(primary_x) and xj == primary_x) and cj < primary_created)
                        primary_x       := xj
                        primary_idx     := j
                        primary_created := cj
                    else if na(primary_x) and cj < primary_created
                        primary_created := cj
                        primary_idx     := j

                    array.push(members, j)
                    j += 1

                if count > 1
                    for k = 0 to array.size(members) - 1
                        idxm = array.get(members, k)
                        L    = array.get(tmp_lbls, idxm)

                        if idxm == primary_idx
                            primary_price = array.get(tmp_price, primary_idx)
                            new_text = label_price ? str.format("{0} ({1})", combined, primary_price) : combined
                            label.set_text(L, new_text)
                            if not na(primary_price)
                                label.set_y(L, primary_price)
                        else
                            label.set_text(L, "")

                i := j

        0

bandz_level_label_text(string baseText, float price) =>
    label_price ? str.format("{0} ({1})", baseText, price) : baseText

bandz_delete_level_mark(BandzLevelMark mark) =>
    if not na(mark.levelLine)
        line.delete(mark.levelLine)
    if not na(mark.levelLabel)
        unregister_label(mark.levelLabel)
        label.delete(mark.levelLabel)

bandz_trim_level_marks(BandzLevelMark[] marks, bool unlimited) =>
    if not unlimited
        while marks.size() > max_days
            BandzLevelMark expired = marks.pop()
            bandz_delete_level_mark(expired)

bandz_delete_period_pair(BandzPeriodPair pair) =>
    if not na(pair.highLine)
        line.delete(pair.highLine)
    if not na(pair.lowLine)
        line.delete(pair.lowLine)
    if not na(pair.highLabel)
        unregister_label(pair.highLabel)
        label.delete(pair.highLabel)
    if not na(pair.lowLabel)
        unregister_label(pair.lowLabel)
        label.delete(pair.lowLabel)

bandz_trim_period_pairs(BandzPeriodPair[] pairs) =>
    if not sep_unlimited
        while pairs.size() > max_days
            BandzPeriodPair expired = pairs.pop()
            bandz_delete_period_pair(expired)


// ---------------------------------------- Functions --------------------------------------------------
bandz_reference_left(bool extendLine, int startBar) =>
    extendLine ? startBar : bar_index + referenceMarkerOffsetBars

bandz_reference_right(bool extendLine, int compactLeft) =>
    extendLine ? bar_index + right_buffer : compactLeft + referenceMarkerLengthBars

bandz_reference_label_x(bool extendLine, int compactRight) =>
    extendLine ? bar_index + right_buffer : compactRight + 1

bandz_sync_period_open(BandzPeriodBook book, bool enabled, bool periodChanged, float openPrice, string labelText, color levelColor, bool extendLine) =>
    if enabled
        // The latest level either stretches from its true period start or floats
        // as a compact marker beside the chart. Old periods freeze automatically
        // when the replacement period is created.
        bool createNow = (periodChanged or book.opens.size() == 0) and not na(openPrice)

        if createNow
            int startBar = bar_index
            int leftX = bandz_reference_left(extendLine, startBar)
            int rightX = bandz_reference_right(extendLine, leftX)
            int labelX = bandz_reference_label_x(extendLine, rightX)
            line newLine = line.new(leftX, openPrice, rightX, openPrice, xloc = xloc.bar_index, extend = extend.none, style = htf_style, width = htf_width, color = levelColor)
            label newLabel = label.new(labelX, openPrice, bandz_level_label_text(labelText, openPrice), xloc = xloc.bar_index, style = label.style_label_left, color = bandz_levels_transparent, textcolor = txt_color, size = lbl_size)
            BandzLevelMark mark = BandzLevelMark.new(newLine, newLabel, openPrice, labelText, startBar)
            book.opens.unshift(mark)
            register_label(openPrice, labelText, newLabel, true)
            bandz_trim_level_marks(book.opens, sep_unlimited)
        else if book.opens.size() > 0
            BandzLevelMark latest = book.opens.get(0)
            int leftX = bandz_reference_left(extendLine, latest.startBar)
            int rightX = bandz_reference_right(extendLine, leftX)
            int labelX = bandz_reference_label_x(extendLine, rightX)
            line.set_xy1(latest.levelLine, leftX, latest.price)
            line.set_xy2(latest.levelLine, rightX, latest.price)
            line.set_color(latest.levelLine, levelColor)
            line.set_style(latest.levelLine, htf_style)
            line.set_width(latest.levelLine, htf_width)
            label.set_x(latest.levelLabel, labelX)
            label.set_y(latest.levelLabel, latest.price)
            label.set_text(latest.levelLabel, bandz_level_label_text(latest.baseText, latest.price))
            label.set_textcolor(latest.levelLabel, txt_color)
            label.set_size(latest.levelLabel, lbl_size)

bandz_sync_period_range(BandzPeriodBook book, bool enabled, bool periodChanged, float previousHigh, float previousLow, string timeframeText, color levelColor, bool extendHigh, bool extendLow) =>
    if enabled
        bool createNow = (periodChanged or book.ranges.size() == 0) and not na(previousHigh) and not na(previousLow)

        if createNow
            string highText = "P" + timeframeText + "H"
            string lowText = "P" + timeframeText + "L"
            int startBar = bar_index

            int highLeftX = bandz_reference_left(extendHigh, startBar)
            int highRightX = bandz_reference_right(extendHigh, highLeftX)
            int highLabelX = bandz_reference_label_x(extendHigh, highRightX)

            int lowLeftX = bandz_reference_left(extendLow, startBar)
            int lowRightX = bandz_reference_right(extendLow, lowLeftX)
            int lowLabelX = bandz_reference_label_x(extendLow, lowRightX)

            line highLine = line.new(highLeftX, previousHigh, highRightX, previousHigh, xloc = xloc.bar_index, extend = extend.none, style = htf_style, width = htf_width, color = levelColor)
            line lowLine = line.new(lowLeftX, previousLow, lowRightX, previousLow, xloc = xloc.bar_index, extend = extend.none, style = htf_style, width = htf_width, color = levelColor)
            label highLabel = label.new(highLabelX, previousHigh, bandz_level_label_text(highText, previousHigh), xloc = xloc.bar_index, style = label.style_label_left, color = bandz_levels_transparent, textcolor = txt_color, size = lbl_size)
            label lowLabel = label.new(lowLabelX, previousLow, bandz_level_label_text(lowText, previousLow), xloc = xloc.bar_index, style = label.style_label_left, color = bandz_levels_transparent, textcolor = txt_color, size = lbl_size)
            BandzPeriodPair pair = BandzPeriodPair.new(highLine, lowLine, highLabel, lowLabel, previousHigh, previousLow, startBar, false, false)
            book.ranges.unshift(pair)
            register_label(previousHigh, highText, highLabel, true)
            register_label(previousLow, lowText, lowLabel, true)
            bandz_trim_period_pairs(book.ranges)
        else if book.ranges.size() > 0
            BandzPeriodPair latest = book.ranges.get(0)

            int highLeftX = bandz_reference_left(extendHigh, latest.startBar)
            int highRightX = bandz_reference_right(extendHigh, highLeftX)
            int highLabelX = bandz_reference_label_x(extendHigh, highRightX)

            int lowLeftX = bandz_reference_left(extendLow, latest.startBar)
            int lowRightX = bandz_reference_right(extendLow, lowLeftX)
            int lowLabelX = bandz_reference_label_x(extendLow, lowRightX)

            line.set_xy1(latest.highLine, highLeftX, latest.highPrice)
            line.set_xy2(latest.highLine, highRightX, latest.highPrice)
            line.set_xy1(latest.lowLine, lowLeftX, latest.lowPrice)
            line.set_xy2(latest.lowLine, lowRightX, latest.lowPrice)
            line.set_color(latest.highLine, levelColor)
            line.set_color(latest.lowLine, levelColor)
            line.set_style(latest.highLine, htf_style)
            line.set_style(latest.lowLine, htf_style)
            line.set_width(latest.highLine, htf_width)
            line.set_width(latest.lowLine, htf_width)
            label.set_x(latest.highLabel, highLabelX)
            label.set_x(latest.lowLabel, lowLabelX)
            label.set_y(latest.highLabel, latest.highPrice)
            label.set_y(latest.lowLabel, latest.lowPrice)
            label.set_text(latest.highLabel, bandz_level_label_text("P" + timeframeText + "H", latest.highPrice))
            label.set_text(latest.lowLabel, bandz_level_label_text("P" + timeframeText + "L", latest.lowPrice))
            label.set_textcolor(latest.highLabel, txt_color)
            label.set_textcolor(latest.lowLabel, txt_color)
            label.set_size(latest.highLabel, lbl_size)
            label.set_size(latest.lowLabel, lbl_size)

        if alert_HL and book.ranges.size() > 0
            BandzPeriodPair currentPair = book.ranges.get(0)
            if not currentPair.highAlerted and high > currentPair.highPrice
                currentPair.highAlerted := true
                alert("Hit P" + timeframeText + "H", alert.freq_once_per_bar)
            if not currentPair.lowAlerted and low < currentPair.lowPrice
                currentPair.lowAlerted := true
                alert("Hit P" + timeframeText + "L", alert.freq_once_per_bar)
            book.ranges.set(0, currentPair)

bandz_sync_ratio_level(BandzRatioBook book, bool enabled, bool periodChanged, float previousHigh, float previousLow, float ratio, color levelColor, string levelText, bool extendLine) =>
    if enabled
        float levelPrice = previousLow + (previousHigh - previousLow) * ratio
        bool createNow = (periodChanged or book.levels.size() == 0) and not na(levelPrice)

        if createNow
            int startBar = bar_index
            int leftX = bandz_reference_left(extendLine, startBar)
            int rightX = bandz_reference_right(extendLine, leftX)
            int labelX = bandz_reference_label_x(extendLine, rightX)
            line newLine = line.new(leftX, levelPrice, rightX, levelPrice, xloc = xloc.bar_index, extend = extend.none, style = eq_style, width = eq_width, color = levelColor)
            label newLabel = na
            if show_level_labels
                newLabel := label.new(labelX, levelPrice, bandz_level_label_text(levelText, levelPrice), xloc = xloc.bar_index, style = label.style_label_left, color = bandz_levels_transparent, textcolor = txt_color, size = lbl_size)
                register_label(levelPrice, levelText, newLabel, true)
            BandzLevelMark mark = BandzLevelMark.new(newLine, newLabel, levelPrice, levelText, startBar)
            book.levels.unshift(mark)
            bandz_trim_level_marks(book.levels, sep_unlimited)
        else if book.levels.size() > 0
            BandzLevelMark latest = book.levels.get(0)
            int leftX = bandz_reference_left(extendLine, latest.startBar)
            int rightX = bandz_reference_right(extendLine, leftX)
            int labelX = bandz_reference_label_x(extendLine, rightX)
            line.set_xy1(latest.levelLine, leftX, latest.price)
            line.set_xy2(latest.levelLine, rightX, latest.price)
            line.set_color(latest.levelLine, levelColor)
            line.set_style(latest.levelLine, eq_style)
            line.set_width(latest.levelLine, eq_width)
            if not na(latest.levelLabel)
                label.set_x(latest.levelLabel, labelX)
                label.set_y(latest.levelLabel, latest.price)
                label.set_text(latest.levelLabel, bandz_level_label_text(latest.baseText, latest.price))
                label.set_textcolor(latest.levelLabel, txt_color)
                label.set_size(latest.levelLabel, lbl_size)

bandz_render_reference_levels() =>
    bool generalTimeframeAllowed = timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit)

    // Daily/yearly references keep the general gate.
    bandz_sync_period_open(dailyBook, generalTimeframeAllowed and show_d_open, bandz_day_changed, current_d_open, "D OPEN", d_color, d_open_extend)
    bandz_sync_period_open(yearlyBook, generalTimeframeAllowed and show_y_open, bandz_year_changed, current_y_open, "Y OPEN", y_color, y_open_extend)
    bandz_sync_period_range(dailyBook, generalTimeframeAllowed and dhl, bandz_day_changed, prev_d_high, prev_d_low, "D", d_color, pdh_extend, pdl_extend)

    // Weekly/monthly opens and highs/lows use the same timeframe windows as
    // their 25/50/75 levels, but each drawing has its own extend/compact toggle.
    bandz_sync_period_open(weeklyBook, is_weekly_levels_tf and show_w_open, bandz_week_changed, current_w_open, "W OPEN", w_color, w_open_extend)
    bandz_sync_period_range(weeklyBook, is_weekly_levels_tf and whl, bandz_week_changed, prev_w_high, prev_w_low, "W", w_color, pwh_extend, pwl_extend)

    bandz_sync_period_open(monthlyBook, is_monthly_levels_tf and show_m_open, bandz_month_changed, current_m_open, "M OPEN", m_color, m_open_extend)
    bandz_sync_period_range(monthlyBook, is_monthly_levels_tf and mhl, bandz_month_changed, prev_m_high, prev_m_low, "M", m_color, pmh_extend, pml_extend)

    bandz_sync_ratio_level(dailyEqBook, generalTimeframeAllowed and show_d_eq, bandz_day_changed, prev_d_high, prev_d_low, 0.50, d_eq_color, d_eq_label_txt, d_eq_extend)
    bandz_sync_ratio_level(weekly25Book, auto_htf_levels and is_weekly_levels_tf and show_w_25, bandz_week_changed, prev_w_high, prev_w_low, 0.25, w_25_color, w_25_label_txt, w_25_extend)
    bandz_sync_ratio_level(weeklyEqBook, auto_htf_levels and is_weekly_levels_tf and show_w_eq, bandz_week_changed, prev_w_high, prev_w_low, 0.50, w_eq_color, w_eq_label_txt, w_eq_extend)
    bandz_sync_ratio_level(weekly75Book, auto_htf_levels and is_weekly_levels_tf and show_w_75, bandz_week_changed, prev_w_high, prev_w_low, 0.75, w_75_color, w_75_label_txt, w_75_extend)
    bandz_sync_ratio_level(monthly25Book, auto_htf_levels and is_monthly_levels_tf and show_m_25, bandz_month_changed, prev_m_high, prev_m_low, 0.25, m_25_color, m_25_label_txt, m_25_extend)
    bandz_sync_ratio_level(monthlyEqBook, auto_htf_levels and is_monthly_levels_tf and show_m_eq, bandz_month_changed, prev_m_high, prev_m_low, 0.50, m_eq_color, m_eq_label_txt, m_eq_extend)
    bandz_sync_ratio_level(monthly75Book, auto_htf_levels and is_monthly_levels_tf and show_m_75, bandz_month_changed, prev_m_high, prev_m_low, 0.75, m_75_color, m_75_label_txt, m_75_extend)

bandz_render_reference_levels()

// ============================================================================
// ============================ ADR CALCULATION ===============================
// ============================================================================
// Current-day time/open metadata is fixed as soon as the daily bar begins.
// ADR is shifted by one full daily bar, so lookahead_on exposes only confirmed
// information and lets intraday markers exist from day one.
[dailyStart, dailyEnd, dailyOpen, dailyAdr] = request.security(
     syminfo.tickerid,
     "D",
     [time, time_close, open, ta.sma(high - low, adrLength)[1]],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

newDailyPeriod = not na(dailyStart) and (
     na(dailyStart[1]) or
     dailyStart != dailyStart[1]
)

adrTimeframeSupported = timeframe.in_seconds() <=
     timeframe.in_seconds("D")

var array<line> adrLines = array.new_line()
var array<label> adrLabels = array.new_label()

var line currentUpperThirdLine = na
var line currentLowerThirdLine = na
var line currentUpperFullLine = na
var line currentLowerFullLine = na

var label currentUpperThirdLabel = na
var label currentLowerThirdLabel = na
var label currentUpperFullLabel = na
var label currentLowerFullLabel = na

upperThirdLevel = not na(dailyOpen) and not na(dailyAdr) ?
     dailyOpen + dailyAdr / 3.0 :
     na

lowerThirdLevel = not na(dailyOpen) and not na(dailyAdr) ?
     dailyOpen - dailyAdr / 3.0 :
     na

upperFullLevel = not na(dailyOpen) and not na(dailyAdr) ?
     dailyOpen + dailyAdr :
     na

lowerFullLevel = not na(dailyOpen) and not na(dailyAdr) ?
     dailyOpen - dailyAdr :
     na

adrReady = showAdr and
     adrTimeframeSupported and
     not na(upperThirdLevel) and
     not na(lowerThirdLevel) and
     not na(upperFullLevel) and
     not na(lowerFullLevel)

if adrReady and newDailyPeriod
    markerLeft = bar_index + adrMarkerOffsetBars
    markerRight = markerLeft + adrMarkerLengthBars
    labelX = markerRight + 1

    currentUpperThirdLine := line.new(
         markerLeft,
         upperThirdLevel,
         markerRight,
         upperThirdLevel,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = adrColor,
         style = line.style_solid,
         width = adrMarkerWidth,
         force_overlay = true
    )

    currentLowerThirdLine := line.new(
         markerLeft,
         lowerThirdLevel,
         markerRight,
         lowerThirdLevel,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = adrColor,
         style = line.style_solid,
         width = adrMarkerWidth,
         force_overlay = true
    )

    currentUpperFullLine := line.new(
         markerLeft,
         upperFullLevel,
         markerRight,
         upperFullLevel,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = adrColor,
         style = line.style_solid,
         width = adrMarkerWidth,
         force_overlay = true
    )

    currentLowerFullLine := line.new(
         markerLeft,
         lowerFullLevel,
         markerRight,
         lowerFullLevel,
         xloc = xloc.bar_index,
         extend = extend.none,
         color = adrColor,
         style = line.style_solid,
         width = adrMarkerWidth,
         force_overlay = true
    )

    currentUpperThirdLabel := label.new(
         labelX,
         upperThirdLevel,
         "+1/3",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = label.style_label_left,
         color = color.new(adrColor, 100),
         textcolor = adrColor,
         size = size.tiny,
         textalign = text.align_left,
         force_overlay = true
    )

    currentLowerThirdLabel := label.new(
         labelX,
         lowerThirdLevel,
         "-1/3",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = label.style_label_left,
         color = color.new(adrColor, 100),
         textcolor = adrColor,
         size = size.tiny,
         textalign = text.align_left,
         force_overlay = true
    )

    currentUpperFullLabel := label.new(
         labelX,
         upperFullLevel,
         "+1",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = label.style_label_left,
         color = color.new(adrColor, 100),
         textcolor = adrColor,
         size = size.tiny,
         textalign = text.align_left,
         force_overlay = true
    )

    currentLowerFullLabel := label.new(
         labelX,
         lowerFullLevel,
         "-1",
         xloc = xloc.bar_index,
         yloc = yloc.price,
         style = label.style_label_left,
         color = color.new(adrColor, 100),
         textcolor = adrColor,
         size = size.tiny,
         textalign = text.align_left,
         force_overlay = true
    )

    array.push(adrLines, currentUpperThirdLine)
    array.push(adrLines, currentLowerThirdLine)
    array.push(adrLines, currentUpperFullLine)
    array.push(adrLines, currentLowerFullLine)

    array.push(adrLabels, currentUpperThirdLabel)
    array.push(adrLabels, currentLowerThirdLabel)
    array.push(adrLabels, currentUpperFullLabel)
    array.push(adrLabels, currentLowerFullLabel)

    maximumAdrObjects = adrHistory * 4

    while array.size(adrLines) > maximumAdrObjects
        oldAdrLine = array.shift(adrLines)
        oldAdrLabel = array.shift(adrLabels)

        if not na(oldAdrLine)
            line.delete(oldAdrLine)

        if not na(oldAdrLabel)
            label.delete(oldAdrLabel)

// Keep only the current day's markers just to the right of the latest bar.
// Older days freeze at the last bar from their own session.
if adrReady and
     not na(currentUpperThirdLine) and
     not na(currentLowerThirdLine) and
     not na(currentUpperFullLine) and
     not na(currentLowerFullLine)

    markerLeft = bar_index + adrMarkerOffsetBars
    markerRight = markerLeft + adrMarkerLengthBars
    labelX = markerRight + 1

    line.set_xy1(currentUpperThirdLine, markerLeft, upperThirdLevel)
    line.set_xy2(currentUpperThirdLine, markerRight, upperThirdLevel)
    line.set_xy1(currentLowerThirdLine, markerLeft, lowerThirdLevel)
    line.set_xy2(currentLowerThirdLine, markerRight, lowerThirdLevel)
    line.set_xy1(currentUpperFullLine, markerLeft, upperFullLevel)
    line.set_xy2(currentUpperFullLine, markerRight, upperFullLevel)
    line.set_xy1(currentLowerFullLine, markerLeft, lowerFullLevel)
    line.set_xy2(currentLowerFullLine, markerRight, lowerFullLevel)

    label.set_xy(currentUpperThirdLabel, labelX, upperThirdLevel)
    label.set_xy(currentLowerThirdLabel, labelX, lowerThirdLevel)
    label.set_xy(currentUpperFullLabel, labelX, upperFullLevel)
    label.set_xy(currentLowerFullLabel, labelX, lowerFullLevel)

// Merge close reference labels on every last-bar update. The function
// safely no-ops when fewer than two eligible labels exist.
if barstate.islast
    combine_persistent_labels()
//needed to add something diff
