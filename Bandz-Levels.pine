//@version=6
// Bandz Reference Levels — NWOG/NDOG + D/W/M/Y + ADR + Watermark
indicator(title="Bandz Reference Levels + Gaps + ADR", shorttitle="Bandz Levels", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_boxes_count=500, dynamic_requests=true)

// ============================================================================
// ============================  TYPES (NWOG/NDOG)  ===========================
// ============================================================================
type Helper
    string  name

type Settings
    bool    show
    color   color
    color   color_new
    int     size
    string  style
    color   ce_color
    color   ce_color_new
    int     ce_size
    string  ce_style
    color   q25_color
    color   q25_color_new
    color   q75_color
    color   q75_color_new
    string  extend
    bool    EH_show
    color   EH_color
    string  EH_style
    int     EH_size
    int     max_count
    bool    use_background
    color   background
    color   background_new
    bool    label_show
    string  label_size
    color   label_color
    color   label_bgcolor

type GapBox
    line        top
    label       l_top
    line        q25
    line        ce
    line        q75
    line        bottom
    label       l_bottom
    linefill    fill

type Gap
    string  name
    string  date_name
    float   open
    float   middle
    float   close
    int     open_time
    int     close_time
    GapBox  box
    bool    is_current  = false
    bool    is_sunday   = false

type OpenGap
    Gap[]       gaps
    Settings    settings
    line        EventHorizon = na

// ============================================================================
// ============================  NWOG / NDOG INPUTS  ==========================
// ============================================================================
var nwog_gaps = array.new<Gap>()
var OpenGap NWOG = OpenGap.new()
NWOG.gaps     := nwog_gaps
NWOG.settings := Settings.new()

var ndog_gaps = array.new<Gap>()
var OpenGap NDOG = OpenGap.new()
NDOG.gaps     := ndog_gaps
NDOG.settings := Settings.new()

NWOG_Group = "NWOG (New Week Open Gap)"
NDOG_Group = "NDOG (New Day Open Gap)"

// ─── NWOG defaults from screenshots ───
NWOG.settings.show := input.bool(true, "NWOG", group=NWOG_Group, inline="nwog1")
nwogLineColor      = input.color(color.new(color.rgb(103, 58, 183), 0), "", group=NWOG_Group, inline="nwog1")
NWOG.settings.style := input.string("⎯⎯⎯", "", options=["⎯⎯⎯", "----", "····"], group=NWOG_Group, inline="nwog1")
NWOG.settings.size  := input.int(2, "", options=[1, 2, 3, 4], group=NWOG_Group, inline="nwog1")
NWOG.settings.color_new := nwogLineColor
NWOG.settings.color     := nwogLineColor

nwogCEColor = input.color(color.new(color.rgb(103, 58, 183), 0), "C.E.", group=NWOG_Group, inline="nwogce")
NWOG.settings.ce_style := input.string("⎯⎯⎯", "", options=["⎯⎯⎯", "----", "····"], group=NWOG_Group, inline="nwogce")
NWOG.settings.ce_size  := input.int(2, "", options=[1, 2, 3, 4], group=NWOG_Group, inline="nwogce")
NWOG.settings.ce_color_new := nwogCEColor
NWOG.settings.ce_color     := nwogCEColor

nwogQ25Color = input.color(color.new(color.rgb(64, 160, 96), 0), "25%", group=NWOG_Group, inline="nwog25")
NWOG.settings.q25_color_new := nwogQ25Color
NWOG.settings.q25_color     := nwogQ25Color

nwogQ75Color = input.color(color.new(color.rgb(64, 160, 96), 0), "75%", group=NWOG_Group, inline="nwog75")
NWOG.settings.q75_color_new := nwogQ75Color
NWOG.settings.q75_color     := nwogQ75Color

NWOG.settings.EH_show  := input.bool(false, "Event Horizon", group=NWOG_Group, inline="nwogeh")
NWOG.settings.EH_color := input.color(color.new(color.rgb(156, 39, 176), 20), "", group=NWOG_Group, inline="nwogeh")
NWOG.settings.EH_style := input.string("----", "", options=["⎯⎯⎯", "----", "····"], group=NWOG_Group, inline="nwogeh")
NWOG.settings.EH_size  := input.int(1, "", options=[1, 2, 3, 4], group=NWOG_Group, inline="nwogeh")

NWOG.settings.use_background := input.bool(true, "Background", group=NWOG_Group, inline="nwogbg")
nwogBgColor = input.color(color.new(color.rgb(103, 58, 183), 93), "", group=NWOG_Group, inline="nwogbg")
NWOG.settings.background_new := nwogBgColor
NWOG.settings.background     := nwogBgColor

NWOG.settings.label_show    := input.bool(true, "Label", group=NWOG_Group, inline="nwoglabel")
NWOG.settings.label_color   := input.color(color.black, "", group=NWOG_Group, inline="nwoglabel")
NWOG.settings.label_bgcolor := input.color(color.new(color.rgb(54, 58, 69), 100), "", group=NWOG_Group, inline="nwoglabel")
NWOG.settings.label_size    := input.string(size.tiny, "", [size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=NWOG_Group, inline="nwoglabel")

NWOG.settings.max_count := input.int(2, "Maximum number", 1, 50, group=NWOG_Group)
NWOG.settings.extend    := input.string("Always", "Extend Gaps", options=["Always", "Above and below only", "Any that is near current price"], group=NWOG_Group)

// ─── NDOG defaults from screenshots ───
NDOG.settings.show := input.bool(true, "NDOG", group=NDOG_Group, inline="ndog1")
ndogLineColor      = input.color(color.new(color.rgb(46, 46, 46), 0), "", group=NDOG_Group, inline="ndog1")
NDOG.settings.style := input.string("⎯⎯⎯", "", options=["⎯⎯⎯", "----", "····"], group=NDOG_Group, inline="ndog1")
NDOG.settings.size  := input.int(1, "", options=[1, 2, 3, 4], group=NDOG_Group, inline="ndog1")
NDOG.settings.color_new := ndogLineColor
NDOG.settings.color     := ndogLineColor

ndogCEColor = input.color(color.new(color.rgb(46, 46, 46), 0), "C.E.", group=NDOG_Group, inline="ndogce")
NDOG.settings.ce_style := input.string("⎯⎯⎯", "", options=["⎯⎯⎯", "----", "····"], group=NDOG_Group, inline="ndogce")
NDOG.settings.ce_size  := input.int(1, "", options=[1, 2, 3, 4], group=NDOG_Group, inline="ndogce")
NDOG.settings.ce_color_new := ndogCEColor
NDOG.settings.ce_color     := ndogCEColor

ndogQ25Color = input.color(color.new(color.rgb(128, 128, 128), 0), "25%", group=NDOG_Group, inline="ndog25")
NDOG.settings.q25_color_new := ndogQ25Color
NDOG.settings.q25_color     := ndogQ25Color

ndogQ75Color = input.color(color.new(color.rgb(128, 128, 128), 0), "75%", group=NDOG_Group, inline="ndog75")
NDOG.settings.q75_color_new := ndogQ75Color
NDOG.settings.q75_color     := ndogQ75Color

NDOG.settings.use_background := input.bool(true, "Background", group=NDOG_Group, inline="ndogbg")
ndogBgColor = input.color(color.new(color.rgb(46, 46, 46), 93), "", group=NDOG_Group, inline="ndogbg")
NDOG.settings.background_new := ndogBgColor
NDOG.settings.background     := ndogBgColor

NDOG.settings.label_show    := input.bool(true, "Label", group=NDOG_Group, inline="ndoglabel")
NDOG.settings.label_color   := input.color(color.black, "", group=NDOG_Group, inline="ndoglabel")
NDOG.settings.label_bgcolor := input.color(color.new(color.rgb(54, 58, 69), 100), "", group=NDOG_Group, inline="ndoglabel")
NDOG.settings.label_size    := input.string(size.tiny, "", [size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=NDOG_Group, inline="ndoglabel")

NDOG.settings.max_count := input.int(1, "Maximum number", 1, 50, group=NDOG_Group)
NDOG.settings.extend    := input.string("Always", "Extend Gaps", options=["Always", "Above and below only", "Any that is near current price"], group=NDOG_Group)

distance     = input.int(1000, "Number of candles to use in calculation", group="NWOG/NDOG Advanced")
factor       = input.float(10, "Factor multiplier for distance test", group="NWOG/NDOG Advanced")
buffer_bars  = input.int(10, "Extension bars (buffer)", minval=1, maxval=500, step=1, group="NWOG/NDOG Advanced", tooltip="Number of bars to extend lines past current candle")

show_mid_level             = input.bool(true, "Show 50% level", group="NWOG/NDOG Advanced")
min_gap_ticks_for_mid      = input.int(1, "Min gap size for 50% level (ticks)", minval=1, group="NWOG/NDOG Advanced", tooltip="Set to 1 to show the 50% level on basically every real gap.")
show_quarter_levels        = input.bool(true, "Show 25%/75% levels", group="NWOG/NDOG Advanced")
min_gap_ticks_for_quarters = input.int(50, "Min gap size for 25%/75% levels (ticks)", minval=1, group="NWOG/NDOG Advanced", tooltip="Quarter levels only draw when the gap is at least this many ticks.")

atrf = ta.atr(distance) + (ta.stdev(high - low, distance) * factor)

f_get_time_delta() =>
    int tf_seconds = timeframe.in_seconds(timeframe.period)
    int chart_ms_per_bar = tf_seconds * 1000
    chart_ms_per_bar

var int ms_per_bar = f_get_time_delta()

var float[] median = array.new_float()
length = 500
median.unshift(high - low)
if median.size() > length
    median.pop()
float spacing = ta.sma(ta.sma(median.median(), length), length) * .5

// ============================================================================
// ============================  NWOG/NDOG FUNCTIONS  =========================
// ============================================================================
f_get_line_style(string style) =>
    switch style
        '⎯⎯⎯'  => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid

f_format_date(t) =>
    _month = month(t)
    _day = dayofmonth(t)
    _year = year(t) % 100
    str.format("{0,number,00}/{1,number,00}/{2,number,00}", _month, _day, _year)

f_get_end_time() =>
    time + (ms_per_bar * buffer_bars)

method AbovePrice(Gap[] gaps, price) =>
    float delta = -1
    size = gaps.size()
    Gap _return = na
    if size > 0
        for i = size - 1 to 0
            Gap ng = gaps.get(i)
            float mark = math.max(ng.open, ng.close)
            if price < mark
                ndelta = math.abs(mark - price)
                delta := delta == -1 ? ndelta : delta
                if ndelta <= delta
                    delta := ndelta
                    _return := ng
    _return

method BelowPrice(Gap[] gaps, price) =>
    float delta = -1
    size = gaps.size()
    Gap _return = na
    if size > 0
        for i = 0 to size - 1
            Gap ng = gaps.get(i)
            float mark = math.min(ng.open, ng.close)
            if price > mark
                ndelta = math.abs(price - mark)
                delta := delta == -1 ? ndelta : delta
                if ndelta <= delta
                    delta := ndelta
                    _return := ng
    _return

method render(Gap gap, Settings settings) =>
    float gapHigh  = math.max(gap.open, gap.close)
    float gapLow   = math.min(gap.open, gap.close)
    float gapRange = gapHigh - gapLow
    float middle   = gapLow + gapRange * 0.50
    float q25      = gapLow + gapRange * 0.25
    float q75      = gapLow + gapRange * 0.75
    float gapTicks = math.abs(gap.open - gap.close) / syminfo.mintick

    bool showMidLevelNow      = show_mid_level and gapTicks >= min_gap_ticks_for_mid
    bool showQuarterLevelsNow = show_quarter_levels and gapTicks >= min_gap_ticks_for_quarters and showMidLevelNow

    int end_time = f_get_end_time()

    // One live color source per item. This fixes the old/current color mismatch.
    color lineColor = settings.color
    color ceColor   = settings.ce_color
    color q25Color  = settings.q25_color
    color q75Color  = settings.q75_color
    color bgColor   = settings.background

    bool skipSundayNDOG = str.contains(gap.name, "NDOG") and gap.is_sunday

    if skipSundayNDOG
        if not na(gap.box)
            if not na(gap.box.top)
                line.delete(gap.box.top)
            if not na(gap.box.q25)
                line.delete(gap.box.q25)
            if not na(gap.box.ce)
                line.delete(gap.box.ce)
            if not na(gap.box.q75)
                line.delete(gap.box.q75)
            if not na(gap.box.bottom)
                line.delete(gap.box.bottom)
            if not na(gap.box.fill)
                linefill.delete(gap.box.fill)
            label.delete(gap.box.l_top)
            label.delete(gap.box.l_bottom)
            gap.box := na
    else
        if na(gap.box)
            gap.box        := GapBox.new()
            gap.box.top    := line.new(gap.open_time, gapHigh, end_time, gapHigh, xloc=xloc.bar_time, color=lineColor, width=settings.size, style=f_get_line_style(settings.style))
            gap.box.bottom := line.new(gap.open_time, gapLow, end_time, gapLow, xloc=xloc.bar_time, color=lineColor, width=settings.size, style=f_get_line_style(settings.style))

            if showMidLevelNow
                gap.box.ce := line.new(gap.open_time, middle, end_time, middle, xloc=xloc.bar_time, color=ceColor, width=settings.ce_size, style=f_get_line_style(settings.ce_style))

            if showQuarterLevelsNow
                gap.box.q25 := line.new(gap.open_time, q25, end_time, q25, xloc=xloc.bar_time, color=q25Color, width=settings.ce_size, style=f_get_line_style(settings.ce_style))
                gap.box.q75 := line.new(gap.open_time, q75, end_time, q75, xloc=xloc.bar_time, color=q75Color, width=settings.ce_size, style=f_get_line_style(settings.ce_style))

            if settings.use_background
                gap.box.fill := linefill.new(gap.box.top, gap.box.bottom, bgColor)
        else
            line.set_xy1(gap.box.top, gap.open_time, gapHigh)
            line.set_xy2(gap.box.top, end_time, gapHigh)
            line.set_xy1(gap.box.bottom, gap.open_time, gapLow)
            line.set_xy2(gap.box.bottom, end_time, gapLow)

            line.set_color(gap.box.top, lineColor)
            line.set_color(gap.box.bottom, lineColor)
            line.set_style(gap.box.top, f_get_line_style(settings.style))
            line.set_style(gap.box.bottom, f_get_line_style(settings.style))
            line.set_width(gap.box.top, settings.size)
            line.set_width(gap.box.bottom, settings.size)

            if showMidLevelNow
                if na(gap.box.ce)
                    gap.box.ce := line.new(gap.open_time, middle, end_time, middle, xloc=xloc.bar_time, color=ceColor, width=settings.ce_size, style=f_get_line_style(settings.ce_style))
                else
                    line.set_xy1(gap.box.ce, gap.open_time, middle)
                    line.set_xy2(gap.box.ce, end_time, middle)
                    line.set_color(gap.box.ce, ceColor)
                    line.set_style(gap.box.ce, f_get_line_style(settings.ce_style))
                    line.set_width(gap.box.ce, settings.ce_size)
            else
                if not na(gap.box.ce)
                    line.delete(gap.box.ce)
                    gap.box.ce := na

            if showQuarterLevelsNow
                if na(gap.box.q25)
                    gap.box.q25 := line.new(gap.open_time, q25, end_time, q25, xloc=xloc.bar_time, color=q25Color, width=settings.ce_size, style=f_get_line_style(settings.ce_style))
                else
                    line.set_xy1(gap.box.q25, gap.open_time, q25)
                    line.set_xy2(gap.box.q25, end_time, q25)
                    line.set_color(gap.box.q25, q25Color)
                    line.set_style(gap.box.q25, f_get_line_style(settings.ce_style))
                    line.set_width(gap.box.q25, settings.ce_size)

                if na(gap.box.q75)
                    gap.box.q75 := line.new(gap.open_time, q75, end_time, q75, xloc=xloc.bar_time, color=q75Color, width=settings.ce_size, style=f_get_line_style(settings.ce_style))
                else
                    line.set_xy1(gap.box.q75, gap.open_time, q75)
                    line.set_xy2(gap.box.q75, end_time, q75)
                    line.set_color(gap.box.q75, q75Color)
                    line.set_style(gap.box.q75, f_get_line_style(settings.ce_style))
                    line.set_width(gap.box.q75, settings.ce_size)
            else
                if not na(gap.box.q25)
                    line.delete(gap.box.q25)
                    gap.box.q25 := na
                if not na(gap.box.q75)
                    line.delete(gap.box.q75)
                    gap.box.q75 := na

            if settings.use_background
                if na(gap.box.fill)
                    gap.box.fill := linefill.new(gap.box.top, gap.box.bottom, bgColor)
                else
                    linefill.set_color(gap.box.fill, bgColor)
            else
                if not na(gap.box.fill)
                    linefill.delete(gap.box.fill)
                    gap.box.fill := na

        // Force current input colors onto already-created NWOG/NDOG objects every redraw.
        // This is the key fix for NDOG/label colors not updating after changing settings.
        if not na(gap.box.top)
            line.set_color(gap.box.top, lineColor)
        if not na(gap.box.bottom)
            line.set_color(gap.box.bottom, lineColor)
        if not na(gap.box.ce)
            line.set_color(gap.box.ce, ceColor)
        if not na(gap.box.q25)
            line.set_color(gap.box.q25, q25Color)
        if not na(gap.box.q75)
            line.set_color(gap.box.q75, q75Color)
        if not na(gap.box.fill)
            linefill.set_color(gap.box.fill, bgColor)

        if settings.label_show
            string labelText = str.format("{0} {1}", gap.name, gap.date_name)
            if na(gap.box.l_top)
                gap.box.l_top := label.new(end_time, gap.middle, labelText, style=label.style_label_left, xloc=xloc.bar_time, size=settings.label_size, color=settings.label_bgcolor, textcolor=settings.label_color)
            else
                label.set_x(gap.box.l_top, end_time)
                label.set_y(gap.box.l_top, gap.middle)
                label.set_text(gap.box.l_top, labelText)
                label.set_style(gap.box.l_top, label.style_label_left)
                label.set_size(gap.box.l_top, settings.label_size)
                label.set_color(gap.box.l_top, settings.label_bgcolor)
                label.set_textcolor(gap.box.l_top, settings.label_color)

            if not na(gap.box.l_bottom)
                label.delete(gap.box.l_bottom)
                gap.box.l_bottom := na
        else
            if not na(gap.box.l_top)
                label.delete(gap.box.l_top)
                gap.box.l_top := na
            if not na(gap.box.l_bottom)
                label.delete(gap.box.l_bottom)
                gap.box.l_bottom := na
    gap

method reset(Gap gap) =>
    if not na(gap.box)
        if not na(gap.box.top)
            line.delete(gap.box.top)
        if not na(gap.box.q25)
            line.delete(gap.box.q25)
        if not na(gap.box.ce)
            line.delete(gap.box.ce)
        if not na(gap.box.q75)
            line.delete(gap.box.q75)
        if not na(gap.box.bottom)
            line.delete(gap.box.bottom)
        if not na(gap.box.fill)
            linefill.delete(gap.box.fill)
        label.delete(gap.box.l_top)
        label.delete(gap.box.l_bottom)
        gap.box := na

method Add(OpenGap GAP, string name, float o, float c, int t, int t1, int tt) =>
    gap = Gap.new()
    gap.name       := name
    gap.date_name  := f_format_date(tt)
    gap.open       := c
    gap.close      := o
    gap.middle     := (o + c) / 2
    gap.open_time  := t1
    gap.close_time := t
    gap.is_sunday  := dayofweek == dayofweek.sunday
    GAP.gaps.unshift(gap)

    if GAP.gaps.size() > GAP.settings.max_count
        g = GAP.gaps.pop()
        g.reset()
    GAP

method Redraw(OpenGap GAP) =>
    int end_time = f_get_end_time()

    if GAP.gaps.size() > 0
        for i = 0 to GAP.gaps.size() - 1
            g = GAP.gaps.get(i)
            g.is_current := i == 0

            switch GAP.settings.extend
                "Always" =>
                    g.render(GAP.settings)
                "Above and below only" =>
                    g.reset()
                "Any that is near current price" =>
                    t = math.min(g.open, g.close) - high
                    l = low - math.max(g.open, g.close)
                    if (t > 0 and t < atrf) or (l > 0 and l < atrf)
                        g.render(GAP.settings)
                    else
                        g.reset()

        if GAP.settings.extend == "Above and below only" or GAP.settings.EH_show
            prev = GAP.gaps.AbovePrice(close)
            next = GAP.gaps.BelowPrice(close)

            if GAP.settings.extend == "Above and below only"
                if not na(prev)
                    prev.render(GAP.settings)
                if not na(next)
                    next.render(GAP.settings)

            if GAP.settings.EH_show
                if not na(prev) and not na(next) and math.min(prev.open, prev.close) > math.max(next.open, next.close)
                    middleEH = (math.min(prev.open, prev.close) + math.max(next.open, next.close)) / 2
                    if na(GAP.EventHorizon)
                        GAP.EventHorizon := line.new(math.max(prev.open_time, next.open_time), middleEH, end_time, middleEH, xloc=xloc.bar_time, color=GAP.settings.EH_color, width=GAP.settings.EH_size, style=f_get_line_style(GAP.settings.EH_style))
                    else
                        line.set_xy1(GAP.EventHorizon, math.max(prev.open_time, next.open_time), middleEH)
                        line.set_xy2(GAP.EventHorizon, end_time, middleEH)
                        line.set_color(GAP.EventHorizon, GAP.settings.EH_color)
                        line.set_style(GAP.EventHorizon, f_get_line_style(GAP.settings.EH_style))
                        line.set_width(GAP.EventHorizon, GAP.settings.EH_size)
                else
                    if not na(GAP.EventHorizon)
                        line.delete(GAP.EventHorizon)
                        GAP.EventHorizon := na
            else
                if not na(GAP.EventHorizon)
                    line.delete(GAP.EventHorizon)
                    GAP.EventHorizon := na
    else
        if not na(GAP.EventHorizon)
            line.delete(GAP.EventHorizon)
            GAP.EventHorizon := na
    GAP

// ============================================================================
// ============================  NWOG/NDOG MAIN  ==============================
// ============================================================================
dailyBarTime = time("1D")
isNewDay     = ta.change(dailyBarTime) != 0
is_sunday    = dayofweek == dayofweek.sunday

// Add gaps only on confirmed bars so they do not duplicate.
// Redraw on every bar so color/style/extension changes update immediately.
if NWOG.settings.show and timeframe.isintraday
    if bar_index > 0 and barstate.isconfirmed and not is_sunday[1] and is_sunday
        NWOG.Add("NWOG", open, close[1], time, time[1], time)
    NWOG.Redraw()

if NDOG.settings.show and timeframe.isintraday
    bool isSundaySession = dayofweek == dayofweek.sunday
    if barstate.isconfirmed and isNewDay and not isSundaySession and open != close[1]
        NDOG.Add("NDOG", open, close[1], time, time[1], time)
    NDOG.Redraw()

// ============================================================================
// ============================  WATERMARK  ===================================
// ============================================================================
wmShow        = input.bool(true, "Show Watermark", group="Watermark")
title_text    = input.string("Bandz", "Title", group="Watermark - Text")
subtitle_text = input.string("", "Subtitle", group="Watermark - Text")

symInfoCheck = input.bool(false, "Show Symbol Info", group="Watermark - Symbol Info")

textVPos = input.string("top", "Text Vertical Position", options=["top", "middle", "bottom"], group="Watermark - Position")
textHPos = input.string("right", "Text Horizontal Position", options=["left", "center", "right"], group="Watermark - Position")

symVPos = input.string("middle", "Symbol Vertical Position", options=["top", "middle", "bottom"], group="Watermark - Position")
symHPos = input.string("center", "Symbol Horizontal Position", options=["left", "center", "right"], group="Watermark - Position")

cellWidth  = input.int(0, "Cell Width (%)", minval=0, maxval=100, group="Watermark - Cell Size")
cellHeight = input.int(0, "Cell Height (%)", minval=0, maxval=100, group="Watermark - Cell Size")

c_title = input.color(color.new(color.black, 0), "Title Color", group="Watermark - Title")
s_title = input.string("normal", "Title Size", options=["tiny", "small", "normal", "large", "huge", "auto"], group="Watermark - Title")
a_title = input.string("center", "Title Alignment", options=["center", "left", "right"], group="Watermark - Title")

c_subtitle = input.color(color.new(color.rgb(54, 58, 69), 60), "Subtitle Color", group="Watermark - Subtitle")
s_subtitle = input.string("tiny", "Subtitle Size", options=["tiny", "small", "normal", "large", "huge", "auto"], group="Watermark - Subtitle")
a_subtitle = input.string("center", "Subtitle Alignment", options=["center", "left", "right"], group="Watermark - Subtitle")

c_symInfo = input.color(color.new(color.rgb(41, 98, 255), 0), "Symbol Info Color", group="Watermark - Symbol Info")
s_symInfo = input.string("normal", "Symbol Info Size", options=["tiny", "small", "normal", "large", "huge", "auto"], group="Watermark - Symbol Info")
a_symInfo = input.string("center", "Symbol Info Alignment", options=["center", "left", "right"], group="Watermark - Symbol Info")

c_bg = input.color(color.new(color.rgb(54, 58, 69), 100), "Background Color", group="Watermark - Background")

// Original Bandz watermark renderer. It owns two independently positioned
// panels so the branding text and market information retain their controls.
bandz_watermark_size(string selection) =>
    switch selection
        "auto"   => size.auto
        "huge"   => size.huge
        "large"  => size.large
        "small"  => size.small
        "tiny"   => size.tiny
        => size.normal

bandz_watermark_alignment(string selection) =>
    switch selection
        "left"  => text.align_left
        "right" => text.align_right
        => text.align_center

bandz_watermark_position(string vertical, string horizontal) =>
    result = position.bottom_right
    if vertical == "top"
        result := horizontal == "left" ? position.top_left : horizontal == "center" ? position.top_center : position.top_right
    else if vertical == "middle"
        result := horizontal == "left" ? position.middle_left : horizontal == "center" ? position.middle_center : position.middle_right
    else
        result := horizontal == "left" ? position.bottom_left : horizontal == "center" ? position.bottom_center : position.bottom_right
    result

type BandzWatermarkPanels
    table branding
    table marketInfo

var BandzWatermarkPanels bandzWatermark = BandzWatermarkPanels.new(
     table.new(bandz_watermark_position(textVPos, textHPos), 1, 2, border_width = 0),
     table.new(bandz_watermark_position(symVPos, symHPos), 1, 2, border_width = 0))

bandz_render_watermark(BandzWatermarkPanels panels) =>
    table.clear(panels.branding, 0, 0, 0, 1)
    table.clear(panels.marketInfo, 0, 0, 0, 1)

    if wmShow
        table.cell(panels.branding, 0, 0, title_text, width = cellWidth, height = cellHeight, text_color = c_title, text_halign = bandz_watermark_alignment(a_title), text_size = bandz_watermark_size(s_title), bgcolor = c_bg)
        table.cell(panels.branding, 0, 1, subtitle_text, width = cellWidth, height = cellHeight, text_color = c_subtitle, text_halign = bandz_watermark_alignment(a_subtitle), text_size = bandz_watermark_size(s_subtitle), bgcolor = c_bg)

        if symInfoCheck
            string displayedTimeframe = timeframe.isminutes ? timeframe.period + "m" : timeframe.period
            string symbolLine = syminfo.ticker + " | " + displayedTimeframe
            string dateLine = str.tostring(dayofmonth(time_close)) + "/" + str.tostring(month(time_close)) + "/" + str.tostring(year(time_close))
            table.cell(panels.marketInfo, 0, 0, dateLine, width = cellWidth, height = cellHeight, text_color = c_symInfo, text_halign = bandz_watermark_alignment(a_symInfo), text_size = bandz_watermark_size(s_symInfo), bgcolor = c_bg)
            table.cell(panels.marketInfo, 0, 1, symbolLine, width = cellWidth, height = cellHeight, text_color = c_symInfo, text_halign = bandz_watermark_alignment(a_symInfo), text_size = bandz_watermark_size(s_symInfo), bgcolor = c_bg)

if barstate.islast
    bandz_render_watermark(bandzWatermark)

